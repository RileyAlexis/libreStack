@page
@model IndexModel

<!DOCTYPE html>
<html>
    <head>
        <Title>LibreStack</Title>
        <link rel="stylesheet" href="/css/index.css" />
    </head>
    <body>
        <div class="primaryContainer">
        <H1>LibreStack</H1>
        <div class="secondaryContainer">
        <p>LibraryData is null: @(Model.LibraryData == null)</p>
        <p>LibraryData count: @(Model.LibraryData?.Count ?? 0)</p>
        @if (Model.LibraryData != null && Model.LibraryData.Count > 0) {
            @foreach (Librestack.Models.Library item in Model.LibraryData){
                <p>Title: @item.Title</p>
            }
        } else {
            <p>No library data found</p>
        }
        </div>
        </div>
    </body>
</html>