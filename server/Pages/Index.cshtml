@page
@model IndexModel
<!DOCTYPE html>
<html>
<head>
    <Title>LibreStack</Title>
    <link rel="stylesheet" href="/css/index.css" />
</head>
<body>
    <div class="primaryContainer">
        <h1>LibreStack</h1>
        <div class="secondaryContainer">
            @foreach (Librestack.Models.Library item in Model.LibraryData)
            {
                <div class="bookContainer">
                    <p>@item.Title</p>
                    <img width="140px" id="cover-@item.Id" src="data:image/jpeg;base64, @Html.Raw(Model.GetCoverBase64(item.CoverImage))" />
                </div>
            }
        </div>
    </div>
</body>
</html>